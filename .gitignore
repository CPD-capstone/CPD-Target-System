// Used AI to generate this simple .gitignore file. Will expand as needed. - LS

# PlatformIO build output and downloaded dependencies
.pio/

# PlatformIO-generated VS Code files
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Local Wi-Fi credentials; allow the shared template
include/secrets.h
!include/secrets.example.h

# Local environment files; allow the shared template
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.swp
*~
